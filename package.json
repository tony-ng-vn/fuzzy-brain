{
  "name": "fuzzy-brain",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "clippings:sweep": "node scripts/sweep-clippings.mjs",
    "watch:sweep": "node scripts/sweep-watch-items.mjs",
    "fusion:sync": "node scripts/fusion-sync.mjs",
    "fusion:install": "node scripts/fusion-sync.mjs --install",
    "mcp": "node scripts/fuzzy-brain-mcp.mjs",
    "agents:install": "node scripts/install-agents.mjs",
    "test:bench": "node --test --test-concurrency=1 tests/recall-bench-*.test.mjs",
    "test:heavy": "RECALL_BENCH_HEAVY=1 node --test --test-concurrency=1 tests/recall-bench-corpus.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "chrono-node": "^2.10.1",
    "next": "^16.3.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5"
  }
}
