# Polygres (Postgres) connection string. Real value lives in .env.local, never committed.
DATABASE_URL=postgresql://user:password@host:5432/app?sslmode=require

# Tbrain capture is disabled until a source is approved and its real UUID is set.
TBRAIN_ALLOW_CAPTURE=0
TBRAIN_ALLOWED_SOURCE_IDS=
# Local tests require a separate loopback PostgreSQL URL, never the real brain.
# DATABASE_URL_DEV=postgresql://test_user:test_password@127.0.0.1:5432/tbrain_test
